 property=\"og:title\" content=\"Kreo Hive 75 Web Driver\" />\n    <meta property=\"og:description\" content=\"High-performance web driver and visual lighting controller for the Kreo Hive 75 mechanical keyboard via WebHID.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body class=\"bg-[#0b0f17] text-slate-100 antialiased min-h-screen selection:bg-cyan-500/30 selection:text-cyan-200\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix Kreo Hive 75 Web Driver\",\n  \"description\": \"High-performance web driver and visual lighting controller for the Kreo Hive 75 mechanical keyboard via WebHID.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect, useCallback } from \'react\';\nimport { KreoState, ConnectionStatus, KreoDeviceInfo, DriverLogEntry } from \'./types/driver\';\nimport { DEFAULT_STATE, EFFECT_MODES, buildReport, rgbToHex } from \'./driver/protocol\';\nimport { driverSingleton } from \'./driver/webhid\';\nimport { Header } from \'./components/Header\';\nimport { KeyboardVisualizer } from \'./components/KeyboardVisualizer\';\nimport { LightingStudio } from \'./components/LightingStudio\';\nimport { PacketInspector } from \'./components/PacketInspector\';\nimport { ProfilePresets } from \'./components/ProfilePresets\';\nimport { PlatformBridge } from \'./components/PlatformBridge\';\nimport { Sparkles, Sliders, Cpu, ShieldAlert, Check, RefreshCw } from \'lucide-react\';\n\nconst STATE_CACHE_KEY = \'kreo_hive75_active_state\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\'studio\' | \'matrix\' | \'inspector\' | \'presets\' | \'bridge\'>(\'studio\');\n  const [status, setStatus] = useState<ConnectionStatus>(\'simulated\');\n  const [deviceInfo, setDeviceInfo] = useState<KreoDeviceInfo | null>(null);\n  const [logs, setLogs] = useState<DriverLogEntry[]>([]);\n  const [packetsSentCount, setPacketsSentCount] = useState<number>(0);\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Load state from local storage or fall back to DEFAULT_STATE\n  const [state, setState] = useState<KreoState>(() => {\n    try {\n      const cached = localStorage.getItem(STATE_CACHE_KEY);\n      if (cached) {\n        const parsed = JSON.parse(cached);\n        if (typeof parsed.mode === \'number\' && Array.isArray(parsed.rgb)) {\n          return parsed;\n        }\n      }\n    } catch {\n      // ignore\n    }\n    return DEFAULT_STATE;\n  });\n\n  // Subscribe to driver singleton\n  useEffect(() => {\n    const unsubscribe = driverSingleton.subscribe({\n      onStatusChange: (newStatus) => setStatus(newStatus),\n      onDeviceInfoChange: (info) => setDeviceInfo(info),\n      onLog: (entry) => setLogs((prev) => [entry, ...prev.slice(0, 99)]),\n      onPacketSent: () => setPacketsSentCount(driverSingleton.getPacketsCount()),\n    });\n\n    // Send initial cached state\n    driverSingleton.sendState(state);\n\n    return () => unsubscribe();\n  }, []);\n\n  // Update state, persist to localStorage, and push report over USB\n  const handleStateChange = useCallback((newState: KreoState) => {\n    setState(newState);\n    try {\n      localStorage.setItem(STATE_CACHE_KEY, JSON.stringify(newState));\n    } catch {\n      // ignore\n    }\n    driverSingleton.sendState(newState);\n  }, []);\n\n  const handleConnect = async () => {\n    const success = await driverSingleton.requestAndConnect();\n    if (success) {\n      showToast(\'Kreo Hive 75 connected successfully!\');\n      // Resend current state to align physical keyboard\n      driverSingleton.sendState(state);\n    }\n  };\n\n  const handleDisconnect = async () => {\n    await driverSingleton.disconnect();\n    showToast(\'Device disconnected.\');\n  };\n\n  const handleResync = () => {\n    driverSingleton.sendState(state);\n    showToast(\'Sent complete state report to keyboard.\');\n  };\n\n  const handleToggleSimulated = () => {\n    if (status === \'connected\') {\n      driverSingleton.disconnect();\n    }\n    driverSingleton.enableSimulation();\n  };\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(null), 3500);\n  };\n\n  // Knob interaction: volume/brightness control\n  const handleKnobRotate = (delta: number) => {\n    setState((prev) => {\n      const nextBrightness = Math.min(4, Math.max(0, prev.brightness + (delta > 0 ? 1 : -1)));\n      const updated = { ...prev, brightness: nextBrightness };\n      driverSingleton.sendState(updated);\n      return updated;\n    });\n  };\n\n  const handleKnobClick = () => {\n    setState((prev) => {\n      const nextBrightness = prev.brightness > 0 ? 0 : 4;\n      const updated = { ...prev, brightness: nextBrightness };\n      driverSingleton.sendState(updated);\n      return updated;\n    });\n  };\n\n  const currentMode = EFFECT_MODES.find((m) => m.id === state.mode);\n\n  return (\n    <div className=\"min-h-screen bg-[#0b0f17] text-slate-100 flex flex-col font-sans selection:bg-cyan-500/30 selection:text-cyan-200\">\n      {/* 3-Zone Clean Header */}\n      <Header\n        activeTab={activeTab}\n        onTabChange={setActiveTab}\n        status={status}\n        deviceInfo={deviceInfo}\n        onConnect={handleConnect}\n        onDisconnect={handleDisconnect}\n        onResync={handleResync}\n        onToggleSimulated={handleToggleSimulated}\n      />\n\n      {/* Main Content Viewport */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 flex flex-col gap-6\">\n        {/* Status / Notice Toast */}\n        {toastMessage && (\n          <div className=\"p-3 rounded-xl bg-cyan-950/80 border border-cyan-500/40 text-cyan-200 text-xs flex items-center justify-between shadow-lg shadow-black/40\">\n            <div className=\"flex items-center gap-2\">\n              <Check className=\"w-4 h-4 text-cyan-400\" />\n              <span>{toastMessage}</span>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setToastMessage(null)}\n              className=\"text-slate-400 hover:text-white text-xs\"\n            >\n              Dismiss\n            </button>\n          </div>\n        )}\n\n        {/* Hero Section: Live Keyboard Visualizer & Active State Ribbon */}\n        <section className=\"flex flex-col gap-4\">\n          {/* Top Quick Status Strip */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 text-xs text-slate-400 border-b border-slate-800/80 pb-3\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-semibold text-slate-200\">Hardware Target:</span>\n              <span className=\"font-mono text-cyan-400\">Kreo Hive 75 (VID: 0x320F PID: 0x5055)</span>\n              <span className=\"text-slate-600\">\302\267</span>\n              <span>Interface 1</span>\n              <span className=\"text-slate-600\">\302\267</span>\n              <span className=\"text-slate-300\">\n                {status === \'connected\' ? \'Hardware Active\' : \'Virtual Simulation Mode\'}\n              </span>\n            </div>\n\n            <div className=\"flex items-center gap-4 font-mono text-[11px]\">\n              <div>\n                <span className=\"text-slate-500\">Mode: </span>\n                <span className=\"text-cyan-300 font-semibold\">{currentMode?.name}</span>\n              </div>\n              <div>\n                <span className=\"text-slate-500\">Brightness: </span>\n                <span className=\"text-amber-300\">{state.brightness * 25}%</span>\n              </div>\n              <div>\n                <span className=\"text-slate-500\">Speed: </span>\n                <span className=\"text-emerald-300\">{state.speed * 25}%</span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"text-slate-500\">Color: </span>\n                <div\n                  className=\"w-2.5 h-2.5 rounded-full border border-white/20\"\n                  style={{ backgroundColor: state.rainbow ? \'#f43f5e\' : rgbToHex(state.rgb) }}\n                />\n                <span className=\"text-slate-300\">{state.rainbow ? \'Rainbow\' : rgbToHex(state.rgb)}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Interactive Keyboard Visualizer Canvas */}\n          <div className=\"w-full flex justify-center py-2\">\n            <KeyboardVisualizer state={state} onKnobRotate={handleKnobRotate} onKnobClick={handleKnobClick} />\n          </div>\n        </section>\n\n        {/* Tab Navigation Content */}\n        <section className=\"mt-2\">\n          {activeTab === \'studio\' && (\n            <LightingStudio state={state} onChange={handleStateChange} />\n          )}\n\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \'Plus Jakarta Sans\', system-ui, -apple-system, sans-serif;\n  --font-mono: \'JetBrains Mono\', ui-monospace, SFMono-Regular, monospace;\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\", \"w3c-web-hid\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
    }
  }
